{
  "family": "vogueai-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::864624564506:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::864624564506:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "api",
      "image": "864624564506.dkr.ecr.ap-south-1.amazonaws.com/vogueai-api:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "DEBUG", "value": "False" },
        { "name": "PROJECT_NAME", "value": "TryMe app" },
        { "name": "VERSION", "value": "1.0.0" },
        { "name": "API_V1_STR", "value": "/api/v1" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "AWS_REGION", "value": "ap-south-1" },
        { "name": "S3_BUCKET_NAME", "value": "outfit-checker-dev" },
        { "name": "SQS_QUEUE_URL", "value": "https://sqs.ap-south-1.amazonaws.com/864624564506/outfit-checker-jobs" },
        { "name": "BACKEND_CORS_ORIGINS", "value": "[\"*\"]" },
        { "name": "FREE_CREDITS_ON_SIGNUP", "value": "3" },
        { "name": "ACCESS_TOKEN_EXPIRE_MINUTES", "value": "20" },
        { "name": "REFRESH_TOKEN_EXPIRE_DAYS", "value": "7" },
        { "name": "VERIFICATION_CODE_EXPIRE_MINUTES", "value": "10" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:864624564506:secret:vogueai/database-url-DR6vrQ"
        },
        {
          "name": "SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:864624564506:secret:vogueai/jwt-secret-LFiIl5"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:864624564506:secret:vogueai/google-api-key-Q7suRV"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:864624564506:secret:vogueai/openai-api-key-yoIA9z"
        },
        {
          "name": "RAZORPAY_KEY_ID",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:864624564506:secret:vogueai/razorpay-key-id-92j5cj"
        },
        {
          "name": "RAZORPAY_KEY_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-south-1:864624564506:secret:vogueai/razorpay-key-secret-uYsDjJ"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vogueai-api",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8000/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}